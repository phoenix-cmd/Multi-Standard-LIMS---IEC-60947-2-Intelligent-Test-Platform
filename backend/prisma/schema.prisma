generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  laboratories Laboratory[]
  users       User[]
  samples     Sample[]
  equipment   Equipment[]
  reports     Report[]
}

model Laboratory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  location       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  samples        Sample[]
  equipment      Equipment[]
  reports        Report[]

  @@unique([organizationId, code])
}

model User {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  laboratoryId   String
  laboratory     Laboratory    @relation(fields: [laboratoryId], references: [id])
  email          String        @unique
  passwordHash   String
  name           String
  department     String
  avatarInitials String
  signature      String?
  isDeactivated  Boolean       @default(false)
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  userRoles      UserRole[]
  sessions       UserSession[]
  assignedSamples Sample[]
  executedTestRuns TestRun[]
  digitalSignatures DigitalSignature[]
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceName String
  ipAddress  String
  userAgent  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Sample {
  id               String                   @id @default(uuid())
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id])
  laboratoryId     String
  laboratory       Laboratory               @relation(fields: [laboratoryId], references: [id])
  reportNo         String                   @unique
  receivedDate     String
  clientName       String
  clientRef        String
  standardId       String
  standardRevision String
  lifecycleState   String
  assignedToUserId String
  assignedToUser   User                     @relation(fields: [assignedToUserId], references: [id])
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  deletedBy        String?
  specification    MCCBSpecification?
  lifecycleHistory SampleLifecycleHistory[]
  testRuns         TestRun[]
  reports          Report[]
  workflowExecs    WorkflowExecution[]
  investigations   Investigation[]
  digitalThread    DigitalThread?
  attachments      Attachment[]

  @@index([organizationId, laboratoryId])
  @@index([lifecycleState])
}

model MCCBSpecification {
  id                   String   @id @default(uuid())
  sampleId             String   @unique
  sample               Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  frameSize            String
  poles                Int
  ratedCurrent         Float
  ratedVoltage         Float
  insulationVoltage    Float
  impulsWithstand      Float
  shortCircuitUltimate Float
  shortCircuitService  Float
  shortTimeWithstand   Float?
  shortTimeDuration    Float?
  category             String
  releaseType          String
  manufacturer         String
  model                String
  drawingNo            String?
}

model SampleLifecycleHistory {
  id        String   @id @default(uuid())
  sampleId  String
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  state     String
  timestamp DateTime @default(now())
  user      String
  notes     String?
}

model Equipment {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  laboratoryId       String
  laboratory         Laboratory          @relation(fields: [laboratoryId], references: [id])
  assetTag           String              @unique
  name               String
  model              String
  manufacturer       String
  serialNo           String
  category           String
  location           String
  status             String
  hoursUsed          Float               @default(0)
  lastUsedDate       String
  purchaseDate       String
  nextCalibrationDue String
  currentCertNo      String?
  qrCode             String
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  deletedBy          String?
  calibrationHistory CalibrationRecord[]
  attachments        Attachment[]

  @@index([organizationId, laboratoryId])
  @@index([status])
}

model CalibrationRecord {
  id            String    @id @default(uuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date          String
  nextDue       String
  performedBy   String
  certificateNo String
  result        String
  notes         String?
}

model TestRun {
  id              String         @id @default(uuid())
  sampleId        String
  sample          Sample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sequenceId      String
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  executedByUserId String
  executedByUser  User           @relation(fields: [executedByUserId], references: [id])
  verdict         String
  inputs          Json
  waveformData    Json?
  replayLog       Json?
  clauseResults   ClauseResult[]
}

model ClauseResult {
  id            String   @id @default(uuid())
  testRunId     String
  testRun       TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  clauseId      String
  clauseTitle   String
  verdict       String
  measuredValue String?
  limitValue    String?
  unit          String?
  ruleId        String?
  message       String
  timestamp     DateTime @default(now())
}

model Report {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  laboratoryId   String
  laboratory     Laboratory         @relation(fields: [laboratoryId], references: [id])
  reportNo       String             @unique
  sampleId       String
  sample         Sample             @relation(fields: [sampleId], references: [id])
  title          String
  approvalStage  String             @default("Draft")
  status         String             @default("Draft")
  createdByUserId String
  pdfUrl         String?
  data           Json
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  signatures     DigitalSignature[]
}

model DigitalSignature {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  userName    String
  userRole    String
  stage       String
  signedAt    DateTime @default(now())
  contentHash String
  comment     String?
  ipAddress   String
}

model WorkflowExecution {
  id               String    @id @default(uuid())
  sampleId         String
  sample           Sample    @relation(fields: [sampleId], references: [id])
  sequenceId       String
  status           String
  currentStepId    String
  stepResults      Json
  executedByUserId String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

model Investigation {
  id               String    @id @default(uuid())
  organizationId   String
  laboratoryId     String
  sampleId         String
  sample           Sample    @relation(fields: [sampleId], references: [id])
  title            String
  status           String
  failureMechanism String
  rootCauses       Json
  riskLevel        String
  correctives      Json
  preventives      Json
  clauseContext    String?
  createdByUserId  String
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model Notebook {
  id             String    @id @default(uuid())
  organizationId String
  laboratoryId   String
  title          String
  category       String
  authorId       String
  content        Json
  tags           Json
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Scenario {
  id               String    @id @default(uuid())
  organizationId   String
  laboratoryId     String
  title            String
  description      String
  parameters       Json
  simulationResult Json
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model KnowledgeGraphNode {
  id         String   @id @default(uuid())
  nodeId     String   @unique
  label      String
  category   String
  properties Json
  createdAt  DateTime @default(now())
}

model KnowledgeGraphEdge {
  id        String   @id @default(uuid())
  sourceId  String
  targetId  String
  relation  String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
}

model DigitalThread {
  id               String   @id @default(uuid())
  sampleId         String   @unique
  sample           Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  timelineEvents   Json
  digitalTwinState Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attachment {
  id               String     @id @default(uuid())
  organizationId   String
  laboratoryId     String
  name             String
  type             String
  size             Int
  storageKey       String
  url              String
  mimeType         String
  sampleId         String?
  sample           Sample?    @relation(fields: [sampleId], references: [id])
  equipmentId      String?
  equipment        Equipment? @relation(fields: [equipmentId], references: [id])
  uploadedByUserId String
  uploadedAt       DateTime   @default(now())
}

model EventStore {
  id            String   @id @default(uuid())
  streamId      String
  aggregateType String
  aggregateId   String
  eventType     String
  eventData     Json
  metadata      Json
  version       Int
  createdAt     DateTime @default(now())

  @@index([streamId])
  @@index([aggregateType, aggregateId])
}

model OutboxMessage {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  laboratoryId   String
  timestamp      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  userName       String
  action         String
  resource       String
  resourceId     String
  details        String
  ipAddress      String
  userAgent      String
  beforeState    Json?
  afterState     Json?

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  category  String   @default("general")
  priority  String   @default("normal")
  link      String?
  timestamp DateTime @default(now())

  @@index([userId, read])
}

model BackgroundJob {
  id          String    @id @default(uuid())
  type        String
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payload     Json
  result      Json?
  error       String?
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

model SchemaVersion {
  id              String   @id @default(uuid())
  version         String   @unique
  name            String
  checksum        String
  executionTimeMs Int
  appliedAt       DateTime @default(now())
}
